/* Logic for TI K3 based SoCs to boot from a MMC device. */

#include <env/phytec/overlays.env>
#ifdef CONFIG_EMBED_RAUC_ENV
#include <env/phytec/rauc.env>
#endif

fitboot=load mmc ${mmcdev}:${mmcpart} ${addr_fit} fitImage;
	bootm ${addr_fit};

mmcargs=setenv bootargs console=${console} earlycon=${earlycon}
	root=/dev/mmcblk${mmcdev}p${mmcroot} ${raucargs} rootwait rw
	${optargs}
mmcloadimage=load mmc ${mmcdev}:${mmcpart} ${kernel_addr_r} Image
mmcloadfdt=load mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdtfile}
mmcboot=
#ifdef CONFIG_EMBED_RAUC_ENV
	if test -n ${doraucboot}; then run raucinit; fi;
#endif
	run mmcargs;
#if CONFIG_DOFITBOOT_DEFAULT == 1
	if test -n ${dofitboot}; then run fitboot; fi;
#endif
	mmc dev ${mmcdev};
	mmc rescan;
	run mmcloadimage;
	run mmcloadfdt;
	run mmc_apply_overlays;
	run mmc_apply_extensions;
	booti ${kernel_addr_r} - ${fdt_addr_r}
