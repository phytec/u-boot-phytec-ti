dev_update.src=sd
dev_update.dst=ospi

dev_update.load.sd.init=mmc rescan
dev_update.load.sd.tiboot3=load mmc 1 ${loadaddr} tiboot3.bin
dev_update.load.sd.tispl=load mmc 1 ${loadaddr} tispl.bin
dev_update.load.sd.uboot=load mmc 1 ${loadaddr} u-boot.img

dev_update.load.net.init=net list
dev_update.load.net.tiboot3=tftp ${loadaddr} tiboot3.bin
dev_update.load.net.tispl=tftp ${loadaddr} tispl.bin
dev_update.load.net.uboot=tftp ${loadaddr} u-boot.img

dev_update.write.ospi.init=mtd list
dev_update.write.ospi.tiboot3=mtd write ospi.tiboot3 ${loadaddr} 0 ${filesize}
dev_update.write.ospi.tispl=mtd write ospi.tispl ${loadaddr} 0 ${filesize}
dev_update.write.ospi.uboot=mtd write ospi.u-boot ${loadaddr} 0 ${filesize}

dev_update.write.emmc.boot0.init=mmc dev 0 1
dev_update.write.emmc.boot0.tiboot3=mmc write ${loadaddr} 0x0 0x400
dev_update.write.emmc.boot0.tispl=mmc write ${loadaddr} 0x400 0x1000
dev_update.write.emmc.boot0.uboot=mmc write ${loadaddr} 0x1400 0x2000

dev_update.write.emmc.boot1.init=mmc dev 0 2
dev_update.write.emmc.boot1.tiboot3=run dev_update.write.emmc.boot0.tiboot3
dev_update.write.emmc.boot1.tispl=run dev_update.write.emmc.boot0.tispl
dev_update.write.emmc.boot1.uboot=run dev_update.write.emmc.boot0.uboot

dev_update=
	run dev_update.load.${dev_update.src}.init &&
	run dev_update.write.${dev_update.dst}.init &&
	run dev_update.load.${dev_update.src}.tiboot3 &&
	run dev_update.write.${dev_update.dst}.tiboot3 &&
	run dev_update.load.${dev_update.src}.tispl &&
	run dev_update.write.${dev_update.dst}.tispl &&
	run dev_update.load.${dev_update.src}.uboot &&
	run dev_update.write.${dev_update.dst}.uboot;
