#include "k3-am62l3-evm-binman.dtsi"

/ {
	aliases {
		mmc1 = &sdhci1;
	};
};

&scmi {
	bootph-all;
};

&ospi0 {
	flash@0 {
		spi-max-frequency = <25000000>;
	};

	flash@3 {
		spi-max-frequency = <25000000>;
	};
};

&cbass_main {
	system-controller {
		compatible = "ti,am62l-sci";
		ti,host-id = <12>;
		bootph-all;
	};
};
