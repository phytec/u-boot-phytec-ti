config PHYTEC_SOM_DETECTION
	bool "Support SoM detection for PHYTEC platforms"
	select SPL_CRC8 if SPL
	help
	   Support of I2C EEPROM based SoM detection.

config PHYTEC_SOM_DETECTION_BLOCKS
	bool "Extend SoM detection with block support"
	depends on PHYTEC_SOM_DETECTION
	help
	   Extend the I2C EEPROM based SoM detection with API v3. This API
	   introduces blocks with different payloads.

config PHYTEC_AM62A_SOM_DETECTION
	bool "Support SoM detection for AM62A Phytec platforms"
	depends on (TARGET_PHYCORE_AM62AX_A53 || TARGET_PHYCORE_AM62AX_R5)
	select PHYTEC_SOM_DETECTION
	help
	   Support of I2C EEPROM based SoM detection. Supported
	   for PHYTEC AM62Ax boards.

config PHYTEC_AM62_SOM_DETECTION
	bool "Support SoM detection for AM62 Phytec platforms"
	depends on (TARGET_PHYCORE_AM62X_A53 || TARGET_PHYCORE_AM62X_R5)
	select PHYTEC_SOM_DETECTION
	help
	   Support of I2C EEPROM based SoM detection. Supported
	   for PHYTEC AM62xx boards.

config PHYTEC_AM64_SOM_DETECTION
	bool "Support SoM detection for AM64 Phytec platforms"
	depends on (TARGET_PHYCORE_AM64X_A53 || TARGET_PHYCORE_AM64X_R5)
	select PHYTEC_SOM_DETECTION
	help
	   Support of I2C EEPROM based SoM detection. Supported
	   for PHYTEC AM64xx boards.

config PHYTEC_K3_KEY_BLOB_COPY
	bool "Copy the MPK Key and the degenerate TI key to the build path"
	default y
	help
	   The recommendation is inactive for using the original key instead of
	   generating a copy of the key!
	   If active, then copy original key to the build directory for
	   compatibility to TI keys in the git repository solution.

config PHYTEC_K3_MPK_KEY
	string "Path to customer specific MPK key"
	default "custMpk.pem" if PHYTEC_K3_KEY_BLOB_COPY
	default "board/ti/keys/custMpk.pem" if !PHYTEC_K3_KEY_BLOB_COPY
	help
	  Path to the signing MPK key
	  If PHYTEC_K3_KEY_BLOB_COPY, then path to blob copy of the original key
	  If !PHYTEC_K3_KEY_BLOB_COPY, then path to original key

config PHYTEC_K3_DEGENERATE_KEY
	string "Path to the degenerate TI key"
	default "ti-degenerate-key.pem" if PHYTEC_K3_KEY_BLOB_COPY
	default "board/ti/keys/ti-degenerate-key.pem" if !PHYTEC_K3_KEY_BLOB_COPY
	help
	  Path to the degenerate key
	  If PHYTEC_K3_KEY_BLOB_COPY, then path to blob copy of the original key
	  If !PHYTEC_K3_KEY_BLOB_COPY, then path to original key
